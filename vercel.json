{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/moderate",
      "destination": "/api/index.py"
    },
    {
      "source": "/ui/:path*",
      "destination": "/frontend/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/user.html"
    }
  ]
}
